# 复制为 .env（唯一规范文件名），生产与本地 Docker Compose 均读取它。
# 切勿提交 .env。生成随机密钥：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# 注意：以下连接串由 docker-compose.prod.yml 从 POSTGRES_* / REDIS_PASSWORD /
# MINIO_* 自动派生（单一事实来源），无需在 .env 里再写 DATABASE_URL / REDIS_URL：
#   DATABASE_URL = postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
#   REDIS_URL    = redis://redis:6379/0
#   MINIO_ENDPOINT = minio:9000
# 密码必须是 URL 安全字符（不含 @ : / # %），否则会破坏连接串。

APP_ENV=production
APP_PORT=8008

# ---- 数据层（PostgreSQL / Redis / MinIO）-----------------------------------
# PostgreSQL（生产数据层；本地 start.py 开发不读取这些，自动回退 SQLite）
POSTGRES_USER=ppt
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
POSTGRES_DB=ppt_platform

# Redis Stream 任务队列（本地 start.py 开发不读取，自动回退进程内队列）
REDIS_PASSWORD=replace-with-a-different-random-url-safe-password

# MinIO 对象存储（上传源文件与导出存档；本地 start.py 开发不读取，自动回退本地文件）
MINIO_ACCESS_KEY=ppt-minio-root-user
MINIO_SECRET_KEY=replace-with-another-random-url-safe-password
# 签名下载 URL 有效期（秒）
FILE_SIGNED_URL_TTL=900

# ---- 必需密钥 --------------------------------------------------------------
DEEPSEEK_API_KEY=replace-with-a-new-deepseek-key
ALI_API_KEY=replace-with-a-new-dashscope-key
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
PERSONALDB_INTERNAL_TOKEN=replace-with-a-different-random-value-of-at-least-32-characters

# ---- 文本生成 --------------------------------------------------------------
MODEL_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
PPT_WRITER_PROVIDER=deepseek
PPT_WRITER_MODEL=deepseek-chat
PPT_CHECKER_PROVIDER=deepseek
PPT_CHECKER_MODEL=deepseek-chat
OUTLINE_STREAMING=true
CONTENT_STREAMING=false

# ---- Qwen 文本向量（DashScope）---------------------------------------------
EMBEDDING_PROVIDER=aliyun
EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIM=1024

# ---- 公开地址与安全策略 ----------------------------------------------------
CORS_ORIGINS=https://ppt.example.com
TRUST_PROXY_HEADERS=true
REQUIRE_INTERNAL_AUTH=true
PERSONALDB_CACHE_ENABLED=false
MAX_UPLOAD_BYTES=20971520
MAX_EXPORT_BYTES=52428800
MAX_PROJECT_DOCUMENT_BYTES=15728640
MAX_PROXY_BYTES=15728640
GENERATION_REQUESTS_PER_HOUR=60
PROXY_ALLOWED_HOSTS=images.pexels.com,images.unsplash.com,source.unsplash.com

# ---- 可选：任务队列与运维 ---------------------------------------------------
WORKER_CONSUMERS=2
# 任务维护（心跳故障转移 / 排队超时 / 事件保留期）
SCHEDULER_INTERVAL=60
SCHEDULER_STALE_RUNNING_SECONDS=120
SCHEDULER_STALE_QUEUED_SECONDS=600
SCHEDULER_RETENTION_DAYS=14
# 备份（每天一次，保留 7 份）
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=7

# ---- 可选图片搜索 ----------------------------------------------------------
PEXELS_API_KEY=
USE_CHART=true
USE_MINERU=false
